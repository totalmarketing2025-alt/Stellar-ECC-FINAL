# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run 'flutter pub get' first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # SQLCipher requires this to avoid bitcode-related build failures on
      # some Xcode versions; harmless no-op on versions where it's unused.
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end

  # Keep the Runner linked to SQLCipher. Firebase Messaging can also bring in
  # the system sqlite3 library on iOS; the last-resort cipher_version check
  # in StellarDatabase.open must never be the first indication of a link issue.
  installer.aggregate_targets.map(&:user_project).uniq.each do |user_project|
    runner = user_project.targets.find { |target| target.name == 'Runner' }
    next unless runner

    runner.build_configurations.each do |config|
      flags = config.build_settings['OTHER_LDFLAGS']
      flags = flags.nil? ? ['$(inherited)'] : [*flags]
      unless flags.each_cons(2).include?(['-framework', 'SQLCipher'])
        flags.concat(['-framework', 'SQLCipher'])
      end
      config.build_settings['OTHER_LDFLAGS'] = flags
      config.build_settings['CODE_SIGN_ENTITLEMENTS'] = 'Runner/Runner.entitlements'
      config.build_settings['APS_ENVIRONMENT'] =
          config.name == 'Debug' ? 'development' : 'production'
    end

    user_project.save
  end
end
