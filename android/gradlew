
#
# Standard Gradle wrapper launcher script. Requires gradle-wrapper.jar to be
# present alongside gradle-wrapper.properties (see the note in this
# project's README about that jar being the one binary artifact this
# generated project is missing, since it must be fetched from
# https://services.gradle.org — no network access was available to fetch
# it while generating this project).
#
# If gradle-wrapper.jar is missing, the fastest fix is running, once, from
# a machine with Gradle installed:
#   gradle wrapper --gradle-version 8.7
# from inside the android/ directory — this regenerates both the jar and
# these scripts to match.
##############################################################################
DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"
APP_HOME=$(cd "$(dirname "$0")" && pwd -P) || exit
APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

CLASSPATH="\$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
