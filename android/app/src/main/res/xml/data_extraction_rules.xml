<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicitly excludes ALL app data from Android's cloud backup and device-
  to-device transfer mechanisms, on top of allowBackup="false" in the
  manifest — belt-and-suspenders per the Phase 2/12 "no cloud backups"
  requirement, since some OEM backup layers only respect this file.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="false">
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
