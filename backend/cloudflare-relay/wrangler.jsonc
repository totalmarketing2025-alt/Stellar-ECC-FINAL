{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stellar-ecc-final",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayRoom"
      }
    ]
  },
  "vars": {
    "DIRECTORY_URL": "https://stellar-ecc-directory.totalmarketing2025.workers.dev",
    "FCM_PROJECT_ID": "stellar-adc4b",
    "FCM_CLIENT_EMAIL": "dev-placeholder@stellar-adc4b.iam.gserviceaccount.com",
    "FCM_PRIVATE_KEY": "DEV_PLACEHOLDER",
    "RELAY_SHARED_SECRET": "stellar-relay-dev-secret"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"]
    }
  ]
}
