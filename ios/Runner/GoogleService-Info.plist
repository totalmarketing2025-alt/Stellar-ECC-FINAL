<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  This file MUST be replaced with the real GoogleService-Info.plist exported
  from your own Firebase project console (Project Settings > Your apps >
  iOS app > GoogleService-Info.plist), then added to ios/Runner in Xcode
  with "Copy items if needed" checked. The keys below are structurally
  correct but the values are non-functional placeholders — push will not
  work until you swap this file.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_WITH_YOUR_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>ecc.stellar.app</string>
	<key>PROJECT_ID</key>
	<string>REPLACE_WITH_YOUR_PROJECT_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>REPLACE_WITH_YOUR_PROJECT_ID.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<false/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
